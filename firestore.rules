rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Usuário único (admin): qualquer usuário autenticado tem acesso total.
    // Não há cadastro público, então "autenticado" == o admin.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
